PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (redirect URI: http://localhost:4000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (redirect URL: <BACKEND_URL>/api/slack/callback, scope: incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- Throughput / rate limiting (all configurable) ----
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard cap per sender per hour (the compose form can only lower it)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Ethereal senders auto-created for a new user
DEFAULT_SENDER_COUNT=2
